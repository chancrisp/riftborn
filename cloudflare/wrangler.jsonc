{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "riftborn-leaderboard",
  "main": "worker.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "routes": [{ "pattern": "api.riftborn.us", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://riftborn.us,https://dev.riftborn.us,https://chancrisp.github.io",
    "SCORE_READ_ONLY_ORIGINS": "https://dev.riftborn.us",
    "AUTH_PUBLIC_BASE": "https://api.riftborn.us"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "riftborn-leaderboard",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "../drizzle"
    }
  ],
  "ratelimits": [
    {
      "name": "SCORE_RATE_LIMITER",
      "namespace_id": "9280928",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "7451062",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "ACCOUNTS_RATE_LIMITER",
      "namespace_id": "6184035",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
